# Copy this file to `.env` and fill in real values. `.env` is git-ignored – never commit it.

# "development" shows PHP errors in the browser; anything else hides them (production).
APP_ENV=development

# Database (see database/create_database.sql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aatman
DB_USER=aatman_app
DB_PASS=change-me-to-a-strong-password

# AI assistant – create a key at https://aistudio.google.com/app/apikey
# Leave empty to disable the chatbot (it will reply that it is not configured).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
